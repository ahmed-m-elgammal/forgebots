;; ForgeBots canonical "Pouncer" tutor bot — Mission 2 in the
;; onboarding ladder.
;;
;; Scans for the nearest enemy, aims, fires when in 30 m range.
;; Falls back to a slow forward walk.
;; See: spec-kit/19-STARTER-BOTS-AND-LIBRARY.md § 2.4
;;
;; Hardware: mk2_engine, radar_long, blaster, solar

(defn step []
  (let ((e (radar)))
    (if (some? e)
        (do (aim (atan2 (- (hit-y e) (self.y))
                         (- (hit-x e) (self.x))))
            (if (< (dist 0 0 (- (hit-x e) (self.x))
                            (- (hit-y e) (self.y)))
                   30000)
                (fire)))
        (move 1 0))))

(every-tick step)
