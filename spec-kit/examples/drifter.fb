;; Drifter — scripted opponent shipped with the game.
;;
;; Picks a random heading every 30 ticks and moves forward.
;; Collects biomass if it sees any.

(defn pick-heading ()
  (let ((h (* 60 (time))))
    (if (== (mod h 1800) 0)
        (rng-int 65536)
        h)))

(defn step ()
  (let ((f (food)))
    (if (some? f)
        (move 1 1)
        (move (cos (pick-heading)) (sin (pick-heading))))))

(every-tick step)
