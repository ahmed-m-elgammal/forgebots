;; ForgeBots canonical example — based on `spec-kit/19-STARTER-BOTS-AND-LIBRARY.md`.
;;
;; Strategy: walks toward the nearest biomass cell. No combat.
;; Mirrors the "Drifter" tutor bot shipped with the game.

(defn pick-heading []
  (let ((h (* 60 (time))))
    (if (== (mod h 1800) 0)
        (rng-int 65536)
        h)))

(defn step []
  (let ((f (food)))
    (if (some? f)
        (move (/ (- (food-x f) (self.x)) 60)
              (/ (- (food-y f) (self.y)) 60))
        (move (cos (pick-heading)) (sin (pick-heading))))))

(every-tick step)
