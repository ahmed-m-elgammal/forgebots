;; ForgeBots canonical example — a complete, minimal bot.
;;
;; Strategy: walk toward the nearest biomass cell, nowhere near the
;; centre of the arena. No combat. This is the "first program" a new
;; player meets in 17-ONBOARDING.md § 2.1.
;;
;; Spec: spec-kit/19-STARTER-BOTS-AND-LIBRARY.md § 2.2 (Glow shape)
;; Units: DSL lengths are integer millimetres. 100000, 100000 is the
;;        arena centre (200 m across, 1 tile = 1 m).
;;
;; Hardware: mk1_engine, solar

(defn step []
  (move-at 100000 100000))

(every-tick step)
